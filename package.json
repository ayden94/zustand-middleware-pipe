{
  "name": "zustand-middleware-pipe",
  "version": "0.1.0-beta.2",
  "description": "Experimental userland helper for composing Zustand middlewares left-to-right.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayden94/zustand-middleware-pipe.git"
  },
  "homepage": "https://github.com/ayden94/zustand-middleware-pipe#readme",
  "bugs": {
    "url": "https://github.com/ayden94/zustand-middleware-pipe/issues"
  },
  "keywords": [
    "zustand",
    "middleware",
    "pipe",
    "state-management"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "docs/i18n"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.js"
    },
    "./middleware/immer": {
      "types": "./dist/middleware/immer.d.ts",
      "import": "./dist/middleware/immer.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "example:install": "npm run build && rm -rf examples/node_modules/zustand-middleware-pipe && npm install --prefix examples --install-links",
    "example:dev": "npm run example:install && npm run dev --prefix examples",
    "example:build": "npm run example:install && npm run build --prefix examples",
    "example:lint": "npm run lint --prefix examples",
    "example:preview": "npm run preview --prefix examples",
    "example:verify": "npm run example:build && npm run example:lint",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run test && npm run build && npm run test:exports",
    "test:exports": "node test/import-exports.mjs"
  },
  "peerDependencies": {
    "immer": ">=9.0.6",
    "zustand": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "immer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.19.11",
    "immer": "^10.1.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9",
    "zustand": "^5.0.8"
  }
}
